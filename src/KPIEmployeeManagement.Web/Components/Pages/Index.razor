@page "/"
@rendermode InteractiveServer
@using KPIEmployeeManagement.Core.Models
@using KPIEmployeeManagement.Data.Services
@inject IKpiEmployeeService EmployeeService
@implements IAsyncDisposable

<div class="container">
    <div class="app-header">
        <h1>🎯 KPI Employee Management System</h1>
        <p>Quản lý KPI nhân viên - Hiệu quả và chuyên nghiệp</p>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert @messageClass">
            @message
        </div>
    }

    <div class="actions-row">
        <button class="btn btn-primary" @onclick="OpenAddModal">➕ Thêm Nhân Viên</button>
        <button class="btn btn-success" @onclick="RefreshData">🔄 Làm Mới</button>
        <input type="text" placeholder="🔍 Tìm kiếm theo tên..." @bind="searchTerm" @bind:event="oninput" class="form-control" style="max-width: 300px;">
    </div>

    @if (employees == null)
    {
        <div class="alert alert-info">⏳ Đang tải dữ liệu...</div>
    }
    else if (filteredEmployees.Count == 0)
    {
        <div class="alert alert-info">📭 Không có dữ liệu nhân viên nào</div>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Mã NV</th>
                    <th>Tên Nhân Viên</th>
                    <th>Email</th>
                    <th>Phòng Ban</th>
                    <th>Trạng Thái</th>
                    <th>Hành Động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var emp in filteredEmployees)
                {
                    <tr>
                        <td>@emp.Seq</td>
                        <td>@emp.Empno</td>
                        <td>@emp.Employee</td>
                        <td>@emp.Email</td>
                        <td>@emp.Department</td>
                        <td>
                            @if (emp.Status == "A")
                            {
                                <span class="badge badge-active">✓ Hoạt Động</span>
                            }
                            else
                            {
                                <span class="badge badge-inactive">✗ Ngừng</span>
                            }
                        </td>
                        <td>
                            <div class="action-buttons">
                                <button class="btn btn-primary" @onclick="() => OpenEditModal(emp)">✏️ Sửa</button>
                                <button class="btn btn-danger" @onclick="() => DeleteEmployee(emp.Seq)">🗑️ Xóa</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<!-- Modal Add/Edit -->
<div class="modal-overlay @(showModal ? "show" : "")">
    <div class="modal-content">
        <div class="modal-header">
            <h2>@(isEditing ? "✏️ Chỉnh Sửa Nhân Viên" : "➕ Thêm Nhân Viên")</h2>
            <button class="modal-close" @onclick="CloseModal">✕</button>
        </div>

        <div class="form-group">
            <label>Mã Nhân Viên *</label>
            <input type="text" class="form-control" @bind="currentEmployee.Empno" />
        </div>

        <div class="form-group">
            <label>Tên Nhân Viên *</label>
            <input type="text" class="form-control" @bind="currentEmployee.Employee" />
        </div>

        <div class="form-group">
            <label>Email</label>
            <input type="email" class="form-control" @bind="currentEmployee.Email" />
        </div>

        <div class="form-group">
            <label>Phòng Ban</label>
            <input type="text" class="form-control" @bind="currentEmployee.Department" />
        </div>

        <div class="form-group">
            <label>Trạng Thái</label>
            <select class="form-control" @bind="currentEmployee.Status">
                <option value="A">Hoạt Động</option>
                <option value="I">Ngừng</option>
            </select>
        </div>

        <div class="form-group">
            <label>Nhóm (Grpno)</label>
            <input type="text" class="form-control" @bind="currentEmployee.Grpno" />
        </div>

        <div class="form-group">
            <label>Chi Nhánh (Brcd)</label>
            <input type="text" class="form-control" @bind="currentEmployee.Brcd" />
        </div>

        <div class="modal-footer">
            <button class="btn btn-secondary" @onclick="CloseModal">Hủy</button>
            <button class="btn btn-primary" @onclick="SaveEmployee">💾 Lưu</button>
        </div>
    </div>
</div>

@code {
    private List<KpiEmployee>? employees;
    private KpiEmployee currentEmployee = new();
    private bool showModal = false;
    private bool isEditing = false;
    private string message = "";
    private string messageClass = "";
    private string searchTerm = "";

    protected override async Task OnInitializedAsync()
    {
        await RefreshData();
    }

    private List<KpiEmployee> get FilteredEmployees
    {
        get
        {
            if (employees == null) return new();
            if (string.IsNullOrWhiteSpace(searchTerm))
                return employees;
            return employees.Where(e =>
                (e.Employee ?? "").Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                (e.Empno ?? "").Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
            ).ToList();
        }
    }

    private async Task RefreshData()
    {
        try
        {
            employees = await EmployeeService.GetAllEmployeesAsync();
            ShowMessage("✓ Dữ liệu đã được cập nhật", "alert-success");
        }
        catch (Exception ex)
        {
            ShowMessage($"❌ Lỗi: {ex.Message}", "alert-danger");
        }
    }

    private void OpenAddModal()
    {
        currentEmployee = new KpiEmployee { Status = "A" };
        isEditing = false;
        showModal = true;
    }

    private void OpenEditModal(KpiEmployee emp)
    {
        currentEmployee = new KpiEmployee
        {
            Seq = emp.Seq,
            Empno = emp.Empno,
            Employee = emp.Employee,
            Email = emp.Email,
            Department = emp.Department,
            Status = emp.Status,
            Grpno = emp.Grpno,
            Brcd = emp.Brcd,
            Trdt = emp.Trdt,
            CustId = emp.CustId,
            Trctcd = emp.Trctcd,
            UserId = emp.UserId
        };
        isEditing = true;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        currentEmployee = new();
    }

    private async Task SaveEmployee()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(currentEmployee.Employee))
            {
                ShowMessage("❌ Tên nhân viên không được để trống", "alert-danger");
                return;
            }

            if (string.IsNullOrWhiteSpace(currentEmployee.Empno))
            {
                ShowMessage("❌ Mã nhân viên không được để trống", "alert-danger");
                return;
            }

            if (isEditing)
            {
                await EmployeeService.UpdateEmployeeAsync(currentEmployee);
                ShowMessage("✓ Cập nhật thành công!", "alert-success");
            }
            else
            {
                await EmployeeService.CreateEmployeeAsync(currentEmployee);
                ShowMessage("✓ Thêm nhân viên thành công!", "alert-success");
            }

            CloseModal();
            await RefreshData();
        }
        catch (Exception ex)
        {
            ShowMessage($"❌ Lỗi: {ex.Message}", "alert-danger");
        }
    }

    private async Task DeleteEmployee(int id)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "❓ Bạn chắc chắn muốn xóa nhân viên này?"))
            return;

        try
        {
            var success = await EmployeeService.DeleteEmployeeAsync(id);
            if (success)
            {
                ShowMessage("✓ Xóa thành công!", "alert-success");
                await RefreshData();
            }
            else
            {
                ShowMessage("❌ Không tìm thấy nhân viên", "alert-danger");
            }
        }
        catch (Exception ex)
        {
            ShowMessage($"❌ Lỗi: {ex.Message}", "alert-danger");
        }
    }

    private void ShowMessage(string msg, string cssClass)
    {
        message = msg;
        messageClass = cssClass;
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        // Cleanup if needed
        await ValueTask.CompletedTask;
    }
}
